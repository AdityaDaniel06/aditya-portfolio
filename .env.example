# ─────────────────────────────────────────────────────────────
# Chatbot LLM settings. Copy this file to .env.local and edit.
# Works with ANY OpenAI-compatible /chat/completions endpoint.
# With nothing configured (or the LLM down), the chat still works
# in "offline mode", answering from src/data/resume.ts.
# ─────────────────────────────────────────────────────────────

# Option A (default, free, runs on your machine): Ollama  https://ollama.com
#   ollama pull llama3.2        # small and fast
#   ollama pull gpt-oss:20b     # OpenAI's open-weight "ChatGPT-family" model (needs ~16 GB RAM)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=

# Option B: Groq (free tier, hosted, very fast). Key: https://console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=gsk_...

# Option C: OpenRouter (has ":free" models). Key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,openrouter/free   # tried in order if main is rate-limited
# LLM_API_KEY=sk-or-...
# LLM_SITE_URL=https://your-site.com      # optional, shown on OpenRouter's app rankings
# LLM_SITE_NAME=Your Portfolio            # optional
# Free model list: https://openrouter.ai/models?max_price=0

# Option D: Google Gemini (free tier). Key: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...

# Model names change over time; check your provider's model list if one stops working.
# Set to true to skip the LLM entirely and always use offline mode.
LLM_DISABLED=false

# ─────────────────────────────────────────────────────────────
# AI usage limits (per visitor per hour / per day, and site-wide per day).
# Over a limit the chat answers from the resume instead. Needs DATABASE_URL;
# in production without a DB the AI is disabled (fails closed).
# ─────────────────────────────────────────────────────────────
AI_LIMIT_HOUR=5
AI_LIMIT_DAY=10
AI_LIMIT_GLOBAL_DAY=100

# ─────────────────────────────────────────────────────────────
# Neon Postgres: visits, contact messages, rate limits.
# Neon console → your project → Connect → copy the POOLED connection string.
# Then create the tables once:  npm run db:setup
# ─────────────────────────────────────────────────────────────
DATABASE_URL=
# Random string; visitor IPs are stored only as salted hashes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# ─────────────────────────────────────────────────────────────
# Contact form email via Resend (free): https://resend.com/api-keys
# With onboarding@resend.dev as sender, Resend only delivers to the email
# your Resend account was created with. Verify a domain to change that.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>   # after verifying a domain in Resend
